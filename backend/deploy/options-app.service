[Unit]
Description=Options Strategy Screener (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=optionsapp
Group=optionsapp
WorkingDirectory=/home/optionsapp/options-app/backend
Environment=DATA_PROVIDER=yfinance
Environment=PATH=/home/optionsapp/options-app/backend/.venv/bin
Environment=DB_PATH=/home/optionsapp/options-app/backend/options_app.db

# --- Auth (required -- the app returns 503 on every request until these are
# set). Generate real values with `python3 scripts/create_admin.py` and
# replace the placeholders below; do not commit real values to git.
Environment=SECRET_KEY=REPLACE_ME_WITH_OUTPUT_OF_create_admin.py
Environment=ADMIN_USERNAME=REPLACE_ME
Environment=ADMIN_PASSWORD_HASH=REPLACE_ME_WITH_OUTPUT_OF_create_admin.py

# --- Trading (optional -- these are the safe defaults: simulated paper
# trading only). To enable real E*TRADE order placement, see
# backend/deploy/CYBERPANEL.md's "Auth & trading setup" section -- it walks
# through the safety implications before you touch ACTIVE_BROKER/
# LIVE_TRADING_ENABLED.
Environment=ACTIVE_BROKER=paper
Environment=LIVE_TRADING_ENABLED=false
Environment=PAPER_STARTING_CASH=100000

ExecStart=/home/optionsapp/options-app/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8005
Restart=always
RestartSec=3

# NoNewPrivileges is harmless sandboxing on its own. ProtectHome/ProtectSystem
# were dropped: ProtectHome=true hides /home from the unit's mount namespace
# and on at least one real deployment (RHEL/AlmaLinux + this exact layout)
# that hid the venv itself even with a matching ReadWritePaths=, so systemd
# couldn't exec .venv/bin/uvicorn at all ("No such file or directory" despite
# the file existing) -- not worth the sandboxing benefit for an app whose
# home dir already is its entire working directory.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
