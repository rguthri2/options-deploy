[Unit]
Description=Options Strategy Screener (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=optionsapp
Group=optionsapp
WorkingDirectory=/home/optionsapp/options-app/backend
Environment=DATA_PROVIDER=yfinance
Environment=PATH=/home/optionsapp/options-app/backend/.venv/bin
ExecStart=/home/optionsapp/options-app/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8005
Restart=always
RestartSec=3

# NoNewPrivileges is harmless sandboxing on its own. ProtectHome/ProtectSystem
# were dropped: ProtectHome=true hides /home from the unit's mount namespace
# and on at least one real deployment (RHEL/AlmaLinux + this exact layout)
# that hid the venv itself even with a matching ReadWritePaths=, so systemd
# couldn't exec .venv/bin/uvicorn at all ("No such file or directory" despite
# the file existing) -- not worth the sandboxing benefit for an app whose
# home dir already is its entire working directory.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
